
generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  master
  admin
}

enum CompanyStatus {
  active
  trial
  suspended
}

model Company {
  id                          String        @id @default(cuid())
  name                        String
  logo                        String?
  contact                     String
  email                       String
  phone                       String
  city                        String
  plan                        String
  monthlyFee                  Int
  vehicleCount                Int
  vehicleLimit                Int
  status                      CompanyStatus @default(trial)
  templateId                  String
  devicePackageId             String
  trackingDeviceUnitPrice     Int
  dashcamUnitPrice            Int
  yearlySubscriptionUnitPrice Int
  enabledFeatures             Json
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt
  lastActiveAt                DateTime?
  vehicles                    Vehicle[]
  drivers                     Driver[]
  customers                   Customer[]
  users                       User[]
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole
  phone        String?
  language     String    @default("en")
  timezone     String    @default("Asia/Riyadh")
  units        String    @default("metric")
  companyId    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  company      Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Driver {
  id            String    @id @default(cuid())
  companyId     String
  name          String
  phone         String?
  email         String?
  licenseNumber String?
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicles      Vehicle[]

  @@index([companyId])
}

model Customer {
  id         String   @id @default(cuid())
  companyId  String
  name       String
  phone      String
  nationalId String
  email      String
  joinedDate DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@unique([companyId, email])
  @@unique([companyId, nationalId])
}

model Vehicle {
  id               String    @id @default(cuid())
  companyId        String
  driverId         String?
  name             String
  plate            String
  icon             String?
  photo            String?
  color            String?
  year             Int?
  fuelType         String?
  lat              Float
  lng              Float
  speed            Int       @default(0)
  engineOn         Boolean   @default(false)
  mileage          Int       @default(0)
  zoneScope        String    @default("city")
  speedLimit       Int       @default(120)
  lastOilChangeKm  Int?
  nextOilChangeKm  Int?
  nextServiceDate  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driver           Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([driverId])
  @@unique([companyId, plate])
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
